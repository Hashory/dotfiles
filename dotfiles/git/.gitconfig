[user]
	name = Hashory
	email = 89839285+Hashory@users.noreply.github.com

[core]
	editor = nvim
	autocrlf = false
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true

[init]
	defaultBranch = main

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
